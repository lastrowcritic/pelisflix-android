{
  "name": "pelisflix",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:live": "PELISFLIX_LIVE=1 vitest run tests/live.test.ts",
    "test:tv": "bash scripts/test-native.sh",
    "android:sync": "npm run build && cap sync android",
    "android:build": "npm run android:sync && bash scripts/build-android.sh",
    "tv": "bash scripts/run-tv.sh"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "cheerio": "1.1.2",
    "hls.js": "1.7.3",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "^1.2.13"
  }
}
